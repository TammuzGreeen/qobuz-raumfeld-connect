{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:raumfeld-connect:api:v1",
  "oneOf": [
    {
      "$ref": "#/definitions/state"
    },
    {
      "$ref": "#/definitions/request"
    },
    {
      "$ref": "#/definitions/decision"
    },
    {
      "$ref": "#/definitions/control"
    }
  ],
  "definitions": {
    "source": {
      "enum": [
        "spotify",
        "external",
        "unknown",
        "qobuz"
      ]
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "zoneId",
        "rendererIds",
        "source",
        "fresh",
        "protected"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "zoneId": {
          "type": [
            "string",
            "null"
          ]
        },
        "rendererIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source": {
          "$ref": "#/definitions/source"
        },
        "fresh": {
          "type": "boolean"
        },
        "unavailableReasons": {
          "type": "array",
          "items": {
            "enum": ["host_unavailable", "topology_stale", "physical_renderer_missing", "physical_observation_missing", "physical_observation_stale", "virtual_observation_missing", "virtual_observation_stale"]
          }
        },
        "protected": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "controllable": {
          "type": "boolean"
        },
        "owned": {
          "type": "boolean"
        },
        "grouped": {
          "type": "boolean"
        },
        "transitioning": {
          "type": "boolean"
        },
        "lastOwnershipLoss": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["reason", "at", "phase"],
          "properties": {
            "reason": {"enum": ["host_lost", "renderer_removed", "topology_changed", "unexpected_source_uri", "token_mismatch", "lease_expired", "room_guard_failed", "physical_membership_changed", "command_failed_or_timed_out", "released", "zone_unavailable", "renderer_unavailable", "source_not_confirmed", "spotify_still_active", "owned_source_guard_failed", "volume_ownership_unconfirmed"]},
            "at": {"type": "number"},
            "phase": {"enum": ["transition", "selection", "owned"]},
            "rendererRole": {"enum": ["physical", "virtual"]},
            "command": {"enum": ["SetAVTransportURI", "Play", "Pause", "Stop", "Seek", "SetVolume", "connectRoomToZone", "unknown"]},
            "commandCode": {"enum": ["ECOMMANDTIMEOUT", "ECONNRESET", "ECONNREFUSED", "ETIMEDOUT", "EHOSTUNREACH", "ENOACTION", "ENOSERVICE", "EUPNP", "command_failed"]},
            "upnpErrorCode": {"type": "integer", "minimum": 100, "maximum": 999},
            "source": {"$ref": "#/definitions/source"},
            "uriKind": {"enum": ["spotify", "empty", "qobuz_relay", "internal_transport", "external"]}
          }
        },
        "lastPlaybackEvidence": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["at", "load", "play", "sourceConfirmed"],
          "properties": {
            "at": {"type": "number"},
            "load": {"enum": ["not_sent", "pending", "acknowledged", "failed"]},
            "play": {"enum": ["not_sent", "pending", "acknowledged", "failed"]},
            "sourceConfirmed": {"type": "boolean"},
            "loadElapsedMs": {"type": "integer", "minimum": 0},
            "playElapsedMs": {"type": "integer", "minimum": 0}
          }
        },
        "lastVolumeCommand": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["at", "connection", "endpoint", "command", "rendererRole", "attempts", "outcome"],
          "properties": {
            "at": {"type": "number"},
            "connection": {"enum": ["node_to_renderer"]},
            "endpoint": {"enum": ["RenderingControl"]},
            "command": {"enum": ["SetRoomVolume"]},
            "rendererRole": {"enum": ["virtual"]},
            "attempts": {"enum": [1]},
            "outcome": {"enum": ["pending", "confirmed", "uncertain", "rejected", "not_confirmed", "failed_closed"]},
            "elapsedMs": {"type": "integer", "minimum": 0},
            "readbackElapsedMs": {"type": "integer", "minimum": 0},
            "soapStatus": {"type": "integer", "minimum": 100, "maximum": 599},
            "code": {"enum": ["ECOMMANDTIMEOUT", "ECONNRESET", "ECONNREFUSED", "ETIMEDOUT", "EHOSTUNREACH", "ENOACTION", "ENOSERVICE", "EUPNP", "command_failed"]},
            "upnpErrorCode": {"type": "integer", "minimum": 100, "maximum": 999},
            "ownership": {"enum": ["confirmed", "unavailable"]},
            "readback": {"enum": ["success", "failed"]},
            "observedVolume": {"type": "integer", "minimum": 0, "maximum": 100}
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "revision",
        "observedAt",
        "host",
        "topologyFresh",
        "topologyAt",
        "capabilities",
        "rooms",
        "zones",
        "renderers"
      ],
      "properties": {
        "apiVersion": {
          "const": "1"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "observationErrors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "failedAt", "action", "code"],
            "properties": {
              "id": {"type": "string"},
              "failedAt": {"type": "number"},
              "action": {"enum": ["GetMediaInfo", "GetTransportInfo", "GetPositionInfo", "QueryLastChange", "Observation"]},
              "code": {"enum": ["ENOACTION", "ENOSERVICE", "ECONNRESET", "ECONNREFUSED", "ETIMEDOUT", "EHOSTUNREACH", "EUPNP", "observation_failed_or_timed_out"]}
            }
          }
        },
        "observedAt": {
          "type": "number"
        },
        "host": {
          "type": [
            "string",
            "null"
          ]
        },
        "topologyFresh": {
          "type": "boolean"
        },
        "topologyAt": {
          "type": [
            "number",
            "null"
          ]
        },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "discovery",
            "playback",
            "qobuzConnect"
          ],
          "properties": {
            "discovery": {
              "const": true
            },
            "playback": {
              "type": "boolean"
            },
            "qobuzConnect": {
              "type": "boolean"
            }
          }
        },
        "rooms": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/room"
          }
        },
        "zones": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "roomIds"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "roomIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "renderers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "source",
              "observedAt",
              "transport",
              "volume",
              "fresh"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "source": {
                "$ref": "#/definitions/source"
              },
              "observedAt": {
                "type": "number"
              },
              "transport": {
                "type": "string"
              },
              "volume": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "fresh": {
                "type": "boolean"
              },
              "positionMs": {
                "type": "integer",
                "minimum": 0
              },
              "durationMs": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roomId",
        "intent"
      ],
      "properties": {
        "roomId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "intent": {
          "enum": [
            "repair",
            "automatic_takeover",
            "explicit_takeover"
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "roomId",
        "revision",
        "policyAllowed",
        "executable",
        "reason",
        "executionBlock"
      ],
      "properties": {
        "apiVersion": {
          "const": "1"
        },
        "roomId": {
          "type": "string"
        },
        "revision": {
          "type": "integer"
        },
        "policyAllowed": {
          "type": "boolean"
        },
        "executable": {
          "const": false
        },
        "reason": {
          "enum": [
            "room_not_found",
            "state_unavailable",
            "explicit_selection",
            "spotify_protected",
            "unknown_source",
            "external_source"
          ]
        },
        "executionBlock": {
          "const": "playback_not_implemented"
        }
      }
    },
    "control": {
      "type": "object",
      "required": [
        "roomId",
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "roomId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "action": {
          "enum": [
            "select",
            "release",
            "heartbeat",
            "play",
            "pause",
            "resume",
            "stop",
            "seek",
            "volume"
          ]
        },
        "token": {
          "type": "string"
        },
        "selectionId": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "value": {
          "type": "integer"
        }
      }
    }
  }
}
