FROM node:24.8.0-bookworm-slim@sha256:cadbfafeb6baf87eaaffa40b3640209c4b7fd38cebde65059d15bc39cd636b85 AS test-deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

FROM raumfeld-connect:dlna-renderers-initial-review
USER root
COPY --from=test-deps /app/node_modules /app/node_modules
RUN /app/qobuz/.venv/bin/python docker/apply-raumkernel-creation-errors.py
COPY tests /app/tests
USER 10001:10001
ENV PYTHONPATH=/app PLAYBACK_PATH=guarded
CMD ["/app/qobuz/.venv/bin/python", "tests/dlna_suite.py"]
